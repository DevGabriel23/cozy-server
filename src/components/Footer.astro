---
// src/components/Footer.astro
const whatsappLink = "https://chat.whatsapp.com/GkyXWfyS66U3k0Ze15sowL";
---

<footer
	class="bg-surface border-t border-hairline py-12 mt-12 relative overflow-hidden"
>
	<div class="absolute inset-0 z-0 pointer-events-none">
		<img
			src="/images/hero-bg.jpg"
			alt="Paisaje de pasto y flores"
			class="w-full h-full object-cover object-bottom opacity-50"
		/>
		<div
			class="absolute inset-0 bg-linear-to-t from-transparent via-surface/75 to-surface"
		>
		</div>
	</div>
	<div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
		<div class="flex flex-col items-center justify-center gap-4 mb-8">
			<img
				src="/images/cozy-server-icon.png"
				alt="Icono del servidor Cozy"
				class="w-16 h-16 object-cover rounded-lg shadow-soft hover:shadow-hover hover:-translate-y-2 transition-all duration-300 ease-in-out"
			/>
			<p class="font-heading text-xl text-ink-primary font-bold">Cozy</p>
		</div>

		<div
			class="flex flex-wrap justify-center gap-4 p-6 bg-on-dark/10 backdrop-blur-md border border-on-dark/20 rounded-lg w-full max-w-md mx-auto shadow-soft"
		>
			<a
				href="/rules"
				class="px-6 py-3 bg-on-dark/80 hover:bg-on-dark text-ink-primary font-semibold rounded-full transition-all duration-200 shadow-sm hover:-translate-y-0.5"
			>
				Reglas
			</a>

			<a
				href="/gallery"
				class="px-6 py-3 bg-on-dark/80 hover:bg-on-dark text-ink-primary font-semibold rounded-full transition-all duration-200 shadow-sm hover:-translate-y-0.5"
			>
				Galería
			</a>

			<a
				href="/support"
				class="px-6 py-3 bg-on-dark/80 hover:bg-on-dark text-ink-primary font-semibold rounded-full transition-all duration-200 shadow-sm hover:-translate-y-0.5"
			>
				Soporte
			</a>

			<a
				href="mailto:gabrielramondev23@gmail.com"
				class="px-6 py-3 bg-on-dark/80 hover:bg-on-dark text-ink-primary font-semibold rounded-full transition-all duration-200 shadow-sm hover:-translate-y-0.5"
			>
				Contacto
			</a>
			<a
				href="https://discord.com/invite/yvdE67HCp"
				target="_blank"
				rel="noopener noreferrer"
				class="px-6 py-3 bg-on-dark/80 hover:bg-on-dark text-ink-primary font-semibold rounded-full transition-all duration-200 shadow-sm hover:-translate-y-0.5"
			>
				Discord
			</a>

			<a
				href={whatsappLink}
				target="_blank"
				rel="noopener noreferrer"
				class="px-6 py-3 bg-on-dark/80 hover:bg-on-dark text-ink-primary font-semibold rounded-full transition-all duration-200 shadow-sm hover:-translate-y-0.5"
			>
				WhatsApp
			</a>
		</div>

		<p class="text-sm text-ink-primary font-body mt-6">
			© {new Date().getFullYear()} Creado con ❤️ para la comunidad.
		</p>
	</div>
</footer>
