---
// src/components/GalleryModal.astro
import { formatRelativeDate } from "../utils/dateUtils";
import type { PostResource } from "../data/galleryPosts";

interface Props {
    id: number | string;
    resources: PostResource[];
    username: string | null;
    date: string;
    description: string;
}

const { id, resources, username, date, description } = Astro.props;
const dialogId = `extended-${id}`;
const hasMultiple = resources.length > 1;
---

<div
    id={dialogId}
    class="extended-dialog fixed inset-0 z-100 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4"
    onclick={`
        this.classList.add('hidden'); 
        this.classList.remove('flex'); 
        document.body.style.overflow = ''; 
        window.history.replaceState({}, '', window.location.pathname);
    `}
>
    <div class="relative w-full max-w-5xl bg-surface rounded-md shadow-soft overflow-hidden flex flex-col md:flex-row h-full max-h-[85vh] m-auto" onclick="event.stopPropagation()">
        <div class="relative w-full md:w-[60%] bg-black flex items-center justify-center group overflow-hidden">
            <div class="carousel-container-modal scrollbar-hidden flex w-full h-full overflow-x-auto snap-x snap-mandatory scroll-smooth">
                {resources.map((res) =>
                    res.type === "video" ? (
                        <video
                            src={res.src}
                            autoplay
                            loop
                            muted
                            playsinline
                            class="min-w-full w-full h-full object-contain snap-center shrink-0"
                        />
                    ) : (
                        <img
                            src={res.src}
                            class="min-w-full w-full h-full object-contain snap-center shrink-0"
                        />
                    )
                )}
            </div>
            {hasMultiple && (
                <>
                    <button class="absolute w-10 h-10 left-4 top-1/2 -translate-y-1/2 bg-surface/80 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition transform hover:scale-110 prev-btn-modal z-10">❮</button>
                    <button class="absolute w-10 h-10 right-4 top-1/2 -translate-y-1/2 bg-surface/80 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition transform hover:scale-110 next-btn-modal z-10">❯</button>
                </>
            )}
        </div>

        <div class="w-full md:w-[40%] p-6 flex flex-col border-l border-hairline">
            <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-3">
                    <div class="rounded-full bg-brand-sage w-10 h-10 flex items-center justify-center text-on-dark text-sm font-bold">
                        {username?.slice(0, 2).toUpperCase()}
                    </div>
                    <h4 class="font-bold text-ink-primary text-lg">{username}</h4>
                </div>
                <button
                    onclick={`
                        const modal = document.getElementById('${dialogId}');
                        modal.classList.add('hidden');
                        modal.classList.remove('flex');
                        document.body.style.overflow = '';
                        window.history.replaceState({}, '', window.location.pathname);
                    `}
                    class="text-ink-muted hover:text-ink-primary text-xl"
                >✕</button>
            </div>

            <div class="overflow-y-auto flex-1 pr-2">
                <p class="text-ink-primary text-sm font-body">
                    <span class="font-bold mr-2">{username}</span>{description}
                </p>
            </div>
            <div class="mt-4 pt-4 border-t border-hairline">
                <p class="text-ink-secondary text-sm">{formatRelativeDate(date)}</p>
            </div>
        </div>
    </div>
</div>

<script>
    // Lógica encapsulada solo para los modales
    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll(".extended-dialog").forEach((dialog) => {
            if (dialog.hasAttribute("data-init-modal")) return;
            dialog.setAttribute("data-init-modal", "true");

            const container = dialog.querySelector(".carousel-container-modal");
            dialog.querySelector(".next-btn-modal")?.addEventListener("click", (e) => {
                e.stopPropagation();
                container?.scrollBy({ left: container.clientWidth, behavior: "smooth" });
            });
            dialog.querySelector(".prev-btn-modal")?.addEventListener("click", (e) => {
                e.stopPropagation();
                container?.scrollBy({ left: -container.clientWidth, behavior: "smooth" });
            });
        });
    });
</script>